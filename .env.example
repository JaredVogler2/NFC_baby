# NFC Baby — environment template. Copy to .env.local for local development.
# NEVER commit real values. Real values live in .env.local (git-ignored) or Vercel project
# environment variables. See docs/ENVIRONMENT.md for what each one does and which are required.

# --- Required: Supabase (public; the anon/publishable key is protected by Row Level Security) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PUBLIC_ANON_OR_PUBLISHABLE_KEY

# --- Required on the server: privileged key (bootstrap, invites, notifications). Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_NEVER_IN_BROWSER

# --- Required in production: canonical HTTPS origin written onto NFC tags and in emails/texts.
APP_URL=https://your-production-domain.example

# --- First owner (one-time): the email allowed to create the household when none exists yet.
BOOTSTRAP_OWNER_EMAIL=owner@example.invalid

# --- Optional: automatic SMS. Default off. Only enable after consent + provider registration.
SMS_PROVIDER=off
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# --- Required before storing any phone number: 32 random bytes, base64.
#     Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONTACT_ENCRYPTION_KEY=

# --- Optional: protects /api/v1/notifications/dispatch for an external scheduler / Vercel Cron.
CRON_SECRET=
